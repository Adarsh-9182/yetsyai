# Local workspace database. SQLite needs persistent disk.
DATABASE_URL="file:./dev.db"
# On Vercel, use your managed PostgreSQL connection string instead.
# The Vercel build selects prisma/postgres/schema.prisma automatically.

# Server-only fal.ai key: https://fal.ai/dashboard/keys
# Never use NEXT_PUBLIC_FAL_KEY or commit a real key.
FAL_KEY=""

# Free GPU backend: deploy spaces/wan-studio to your own private ZeroGPU Space.
VIDEO_PROVIDER="huggingface"
HF_SPACE_URL=""
HF_TOKEN=""
HF_STUDIO_SECRET=""

# One Supabase free project supplies accounts, PostgreSQL and private media.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Use a session-pooler / direct owner connection for Prisma migrations.
# PostgreSQL credentials are server-only. Never expose them to the browser.

# Conservative shared-capacity defaults. Failures consume daily allowance.
ACCOUNT_DAILY_RENDER_LIMIT="2"
GLOBAL_DAILY_RENDER_LIMIT="3"
GLOBAL_CONCURRENT_RENDER_LIMIT="1"
CRON_SECRET=""

# Paid mode requires BOTH VIDEO_PROVIDER=fal and this switch; stays off by default.
ENABLE_PAID_GENERATION="false"
# Local-only route development. This never authorizes guests in production.
ALLOW_GUEST_GENERATION="false"
