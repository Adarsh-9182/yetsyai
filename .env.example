# ── Copy this file to ".env" and fill in the values ─────────────────────────

# The AI brain. Get a key at https://console.anthropic.com (Settings → API Keys)
ANTHROPIC_API_KEY=your-key-goes-here

# Which model powers the health companion. opus-5 is most capable;
# claude-sonnet-5 or claude-haiku-4-5 are cheaper alternatives.
NUTRITISCAN_MODEL=claude-opus-5

# Local database (SQLite file — no server needed). Switch to a Postgres URL later.
DATABASE_URL="file:./dev.db"
