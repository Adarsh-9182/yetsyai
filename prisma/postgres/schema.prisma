generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudioWorkspace {
  id          String @id
  userId      String? @unique
  activeJobId String?
  createdAt   DateTime @default(now())
  generations VideoGeneration[]
  assets      StudioAsset[]
}

model StudioQuota {
  id        String @id
  used      Int @default(0)
  updatedAt DateTime @updatedAt
}

model StudioAsset {
  id          String @id
  workspaceId String
  workspace   StudioWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  path        String @unique
  width       Int
  height      Int
  createdAt   DateTime @default(now())
  @@index([workspaceId, createdAt])
}

model VideoGeneration {
  id                String @id
  workspaceId       String
  workspace         StudioWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  prompt            String
  model             String
  provider          String @default("fal")
  seed              Int @default(0)
  storagePath       String?
  quotaReserved     Boolean @default(false)
  aspectRatio       String
  duration          Int
  status            String @default("submitting")
  providerRequestId String?
  statusUrl         String?
  responseUrl       String?
  videoUrl          String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}
