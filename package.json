{
  "name": "yetsyai",
  "version": "0.1.0",
  "private": true,
  "description": "Yetsyai — an AI video creation studio.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.cjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "node scripts/init-local.cjs"
  },
  "overrides": { "postcss": "$postcss" },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "geist": "^1.3.1",
    "lucide-react": "^0.462.0",
    "next": "^15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
